# Copy this file to /srv/bodybuilder/.env on EC2 and set file mode 600.
# Never commit the resulting .env file.

# Stable Compose project name. Changing it creates different networks/volumes.
COMPOSE_PROJECT_NAME=bodybuilder

# The deploy job replaces these with images built locally on EC2.
FRONTEND_IMAGE=
BACKEND_IMAGE=

# Only the gateway is published on the host.
HTTP_PORT=80
HTTPS_PORT=443

# MySQL initialization. Password values must be generated outside this repository.
MYSQL_DATABASE=bodybuilder
MYSQL_USER=bodybuilder
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Valkey authentication. Do not reuse the application or MySQL password.
VALKEY_PASSWORD=

# Exact browser origin, including scheme and optional port (no trailing slash).
CORS_ALLOWED_ORIGIN=

# Use false only during temporary HTTP testing. Change to true with HTTPS.
SESSION_COOKIE_SECURE=false

# Container timezone.
TZ=Asia/Seoul

# OAuth (KAKAO)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=

# OAuth (Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Single-host resource budget defaults. Tune together for the actual EC2 size;
# the documented baseline assumes at least 8 GiB RAM.
GATEWAY_MEMORY_LIMIT=128m
FRONTEND_MEMORY_LIMIT=128m
BACKEND_MEMORY_LIMIT=768m
MYSQL_MEMORY_LIMIT=1024m
VALKEY_MEMORY_LIMIT=256m
