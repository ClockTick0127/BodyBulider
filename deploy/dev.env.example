# Copy to deploy/.env.dev when local overrides are needed.
COMPOSE_PROJECT_NAME=bodybuilder-dev

FRONTEND_PORT=5173
BACKEND_PORT=18080
MYSQL_PORT=13306
VALKEY_PORT=16379
BACKEND_PUBLIC_URL=http://localhost:18080
CORS_ALLOWED_ORIGIN=http://localhost:5173

MYSQL_DATABASE=bodybuilder
MYSQL_USER=bodybuilder
MYSQL_PASSWORD=local_password
MYSQL_ROOT_PASSWORD=local_root_password
VALKEY_PASSWORD=local_password

TZ=Asia/Seoul

VITE_GOOGLE_CLIENT_ID=
VITE_KAKAO_REST_API_KEY=
GOOGLE_CLIENT_ID=dummy-google-client-id
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:18080/api/v1/auth/google/callback
KAKAO_CLIENT_ID=dummy-client-id
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:18080/api/v1/auth/kakao/callback
